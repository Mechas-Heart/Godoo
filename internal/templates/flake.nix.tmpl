# Generated by godoo from godoo.yaml - edit godoo.yaml, then run `godoo setup`.
# flake.lock (next to this file) pins the exact nixpkgs revisions.
#
# Build it yourself:  nix build path:./nix --out-link .godoo/env
{
  description = "godoo: Odoo {{.Version}} environment for {{.Name}}";

  inputs = {
    # PostgreSQL, nginx, mailpit, git, wkhtmltopdf, rtlcss
    nixpkgs.url = "github:NixOS/nixpkgs/{{.Nixpkgs}}";
    # Python and Odoo's python packages (taken from nixpkgs' {{.OdooPackage}} package)
{{- if .SamePin}}
    nixpkgs-python.follows = "nixpkgs";
{{- else}}
    nixpkgs-python.url = "github:NixOS/nixpkgs/{{.PythonNixpkgs}}";
{{- end}}
  };

  outputs = { nixpkgs, nixpkgs-python, ... }:
    let
      # Values copied from godoo.yaml (env: {{.Env}})
      settings = {
        odooPackage = "{{.OdooPackage}}";
        extraPythonPackages = [ {{range .PythonPackages}}"{{.}}" {{end}}];
        # env: local only - dev tools and `godoo pkg add --local`; empty in prod
        localPythonPackages = [ {{range .LocalPythonPackages}}"{{.}}" {{end}}];
        # Not in nixpkgs: pinned pure-python wheels from PyPI (godoo pkg add)
        pypiPackages = [
{{- range .PypiPackages}}
          { name = "{{.Name}}"; version = "{{.Version}}"; url = "{{.URL}}"; hash = "{{.Hash}}"; }
{{- end}}
        ];
        postgresql = "postgresql_{{.Postgres}}";
        mailpit = {{.Mailpit}};
        extraPackages = [ {{range .Packages}}"{{.}}" {{end}}];
        # env: local only - ruff, pre-commit, pgcli, nix.local_packages; empty in prod
        localPackages = [ {{range .LocalPackages}}"{{.}}" {{end}}];
      };

      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];
      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f {
        pkgs = nixpkgs.legacyPackages.${system};
        py = nixpkgs-python.legacyPackages.${system};
      });

      # "a.b" -> set.a.b
      byName = set: name: nixpkgs.lib.getAttrFromPath (nixpkgs.lib.splitString "." name) set;

      # Packages godoo replaces in nixpkgs' list, each with the reason.
      fixes = ps: {
        # nixpkgs >= 25.05 ships the "libpass" fork as passlib 1.9, which calls
        # logging.debug() on import and so prints every Odoo log line twice.
        # Odoo's requirements.txt pins passlib==1.7.4.
        passlib =
          if nixpkgs.lib.versionAtLeast ps.passlib.version "1.9" then
            ps.buildPythonPackage rec {
              pname = "passlib";
              version = "1.7.4";
              format = "setuptools";
              src = ps.fetchPypi {
                inherit pname version;
                hash = "sha256-3v1Q9ytlxUAqssVzgwppeOXyAq0NmEeTyN3ixBUuvgQ=";
              };
              doCheck = false;
            }
          else
            ps.passlib;
      };

      # The package list (and its version fixes) nixpkgs uses to build its own
      # Odoo package, and the python it was built with.
      odooBase = py:
        let
          odoo = py.${settings.odooPackage};
          isLibrary = dep: dep ? pythonModule && !(dep ? withPackages); # drop the interpreter
          deps = builtins.filter isLibrary odoo.propagatedBuildInputs;
          python = (builtins.head deps).pythonModule; # nixpkgs' odoo may patch python
        in
        {
          inherit python;
          packages = map (dep: (fixes python.pkgs).${dep.pname or ""} or dep) deps;
        };

      # A wheel is installed as-is (no build step). Its own dependencies are
      # listed separately in godoo.yaml, so nix's runtime-deps check is off.
      fromPypi = py: ps: wheel: ps.buildPythonPackage {
        pname = wheel.name;
        inherit (wheel) version;
        format = "wheel";
        src = py.fetchurl { inherit (wheel) url hash; };
        dontCheckRuntimeDeps = true;
        doCheck = false;
      };

      # One Python with everything Odoo imports - no virtualenv, no pip.
      # Odoo itself runs from the ./odoo checkout.
      odooPython = py:
        let base = odooBase py; in
        base.python.withPackages (ps:
          base.packages
          ++ map (byName ps) (settings.extraPythonPackages ++ settings.localPythonPackages)
          ++ map (fromPypi py ps) settings.pypiPackages);
    in
    {
      packages = forAllSystems ({ pkgs, py }:
        let
          lib = pkgs.lib;
          wkhtmltopdf = lib.optional
            (pkgs ? wkhtmltopdf-bin && lib.meta.availableOn pkgs.stdenv.hostPlatform pkgs.wkhtmltopdf-bin)
            pkgs.wkhtmltopdf-bin;
        in
        {
          # Just the python: nix build path:./nix#python
          python = odooPython py;

          # Everything the project runs, linked to .godoo/env
          default = pkgs.buildEnv {
            name = "godoo-{{.Name}}-env";
            paths = [
              (odooPython py)
              pkgs.${settings.postgresql}
              pkgs.nginx
              pkgs.git
              pkgs.rtlcss # right-to-left languages
            ]
            ++ lib.optional settings.mailpit pkgs.mailpit
            ++ wkhtmltopdf
            ++ map (byName pkgs) (settings.extraPackages ++ settings.localPackages);
          };
        });

      # The python package set packages are picked from. `godoo pkg add`
      # checks names against it, e.g.
      #   nix eval path:./nix#legacyPackages.x86_64-linux.pythonPackages.pandas.version
      legacyPackages = forAllSystems ({ py, ... }: {
        pythonPackages = (odooBase py).python.pkgs;
        # names already in odoo's set, so godoo does not add them twice
        basePythonPackages = map (dep: dep.pname or "") (odooBase py).packages;
      });
    };
}
