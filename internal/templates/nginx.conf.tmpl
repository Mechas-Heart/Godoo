# Generated by godoo from godoo.yaml on every `godoo up` - do not edit.
daemon off;
worker_processes 1;
pid {{.Prefix}}/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
{{- if .MimeTypes}}
    include {{.MimeTypes}};
{{- end}}
    default_type application/octet-stream;
    access_log {{.AccessLog}};
    sendfile on;
    keepalive_timeout 65;

    # keep every temp file inside the project
    client_body_temp_path {{.Prefix}}/client_body;
    proxy_temp_path       {{.Prefix}}/proxy;
    fastcgi_temp_path     {{.Prefix}}/fastcgi;
    uwsgi_temp_path       {{.Prefix}}/uwsgi;
    scgi_temp_path        {{.Prefix}}/scgi;

    gzip on;
    gzip_min_length 1000;
    gzip_types text/css text/plain text/xml application/xml application/json application/javascript image/svg+xml;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream odoo {
        server 127.0.0.1:{{.OdooPort}};
    }
{{- if gt .Workers 0}}
    upstream odoo_gevent {
        server 127.0.0.1:{{.Gevent}};
    }
{{- end}}

    server {
        listen {{.Listen}}:{{.HTTPPort}};
        server_name {{.ServerName}};

        client_max_body_size {{.MaxBody}};
        proxy_read_timeout 720s;
        proxy_connect_timeout 720s;
        proxy_send_timeout 720s;

        # odoo.conf has proxy_mode = True and trusts these headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
{{- if gt .Workers 0}}

        # workers > 0: realtime traffic is served by the gevent process
        location {{.WebsocketPath}} {
            proxy_pass http://odoo_gevent;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
{{- end}}

        location / {
            proxy_pass http://odoo;
            proxy_redirect off;
            # workers = 0: the threaded server also handles websockets
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
